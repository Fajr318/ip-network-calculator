	import ipaddress
	import unittest


	class TestIPNetworkCalculator(unittest.TestCase):

    def test_network_address(self):
        network = ipaddress.ip_network(
            "192.168.1.10/24", strict=False
        )
        self.assertEqual(
            str(network.network_address), "192.168.1.0"
        )

    def test_broadcast_address(self):
        network = ipaddress.ip_network(
            "192.168.1.10/24", strict=False
        )
        self.assertEqual(
            str(network.broadcast_address), "192.168.1.255"
        )

    def test_total_addresses(self):
        network = ipaddress.ip_network(
            "192.168.1.10/24", strict=False
        )
        self.assertEqual(network.num_addresses, 256)


	if __name__ == "__main__":
    unittest.main()